---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

import '@/global.css';
import '@/styles.css';
import Footer from '@sections/shared/Footer.astro';
import Navbar from '@sections/shared/Navbar.astro';
import { ROUTES } from '@lib/constants';

interface Props {
    description: string;
    noindex?: boolean;
    title: string;
}

const canonicalUrl = new URL(Astro.routePattern, Astro.site);
const currentRoute = ROUTES.find(route => route.href === Astro.routePattern);
const { description, noindex, title } = Astro.props;
const ogImageUrl = `${Astro.site}og.png`;

const breadcrumbRoutes = currentRoute && currentRoute !== ROUTES[0] ? [ROUTES[0], currentRoute] : [];

const breadcrumbList = {
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbRoutes.map((route, index) => ({
        '@type': 'ListItem',
        'item': new URL(route.href, Astro.site).href,
        'name': route.label,
        'position': index + 1,
    })),
};

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        ...(breadcrumbRoutes.length > 0 ? [breadcrumbList] : []),
        {
            '@type': 'ItemList',
            'itemListElement': ROUTES.map((route, index) => ({
                '@type': 'SiteNavigationElement',
                'name': route.label,
                'position': index + 1,
                'url': new URL(route.href, Astro.site).href,
            })),
        },
        {
            '@type': 'WebSite',
            'author': {
                '@type': 'Person',
                'name': 'Anna Madewell',
            },
            'inLanguage': 'en',
            'name': 'EmpowHER Festival',
            'url': Astro.site,
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta content="Anna Madewell" name="author" />
        <meta content={description} name="description" />
        <meta content={noindex ? 'noindex, nofollow' : 'index, follow'} name="robots" />
        <meta content="#0e0816" name="theme-color" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
        <link href={canonicalUrl} rel="canonical" />
        <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
        <meta content={description} property="og:description" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content="en_US" property="og:locale" />
        <meta content="EmpowHER Festival" property="og:site_name" />
        <meta content={title} property="og:title" />
        <meta content="website" property="og:type" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={description} name="twitter:description" />
        <meta content={ogImageUrl} name="twitter:image" />
        <meta content={title} name="twitter:title" />
        <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />
        <Font cssVariable="--font-outfit" preload />
        <Font cssVariable="--font-special-elite" preload />
        <Font cssVariable="--font-unbounded" preload />
        <ClientRouter />
    </head>
    <body class="flex flex-col overflow-x-clip min-h-svh antialiased text-body bg-ink text-paper">
        <Navbar />
        <main class="flex flex-1 flex-col">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<script>
    import { initMotion } from '@lib/motion';

    document.addEventListener('astro:page-load', initMotion);
</script>
