---
import { Image } from 'astro:assets';

import type { ImageMetadata } from 'astro';

interface Logo {
    alt: string;
    fitBlock?: number;
    fitInline?: number;
    image: ImageMetadata;
    isInverted?: boolean;
    isPhoto?: boolean;
}

interface Props {
    isWide?: boolean;
    logos: Logo[];
}

const DEFAULT_FIT = 1;
const SIZES = '(max-width: 48rem) 20rem, (max-width: 64rem) 50vw, 25vw';
const SIZES_WIDE = '(max-width: 48rem) 20rem, (max-width: 64rem) 34vw, 17vw';

const { isWide = false, logos } = Astro.props;

const sizes = isWide ? SIZES_WIDE : SIZES;
---

<ul
    class:list={['logo-wall', { 'logo-wall--wide': isWide }, 'grid gap-5 list-none']}
    data-scroll="scale"
    data-scroll-stagger
>
    {logos.map(logo => (
        <li class:list={['logo-wall__tile', { 'logo-wall__tile--photo': logo.isPhoto }, 'aspect-[4/3]']}>
            <Image
                class:list={['logo-wall__image absolute inset-0 object-contain m-auto', { 'invert opacity-[0.92]': logo.isInverted }]}
                alt={logo.alt}
                loading="lazy"
                sizes={sizes}
                src={logo.image}
                style={`--logo-wall-fit-block: ${logo.fitBlock ?? DEFAULT_FIT}; --logo-wall-fit-inline: ${logo.fitInline ?? DEFAULT_FIT};`}
                widths={[360, 720, 1_200]}
            />
        </li>
    ))}
</ul>

<style>
    .logo-wall {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .logo-wall--wide {
        grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .logo-wall__image {
        --logo-wall-inset: 1rem;
        height: calc((100% - var(--logo-wall-inset) * 2) * var(--logo-wall-fit-block));
        width: calc((100% - var(--logo-wall-inset) * 2) * var(--logo-wall-fit-inline));
    }

    .logo-wall__tile {
        background: var(--color-ink-lighter);
        border: var(--border-soft);
        border-radius: var(--radius-card-sm);
        overflow: hidden;
        position: relative;
        transition:
            border-color var(--duration-base) ease,
            transform var(--duration-base) ease;
    }

    .logo-wall__tile:hover {
        border-color: var(--color-purple-55);
        transform: translateY(-0.375rem) rotate(-1deg);
    }

    .logo-wall__tile--photo .logo-wall__image {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    @media (max-width: 64rem) {
        .logo-wall {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .logo-wall--wide {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 48rem) {
        .logo-wall {
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        }
    }
</style>
