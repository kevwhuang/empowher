---
interface Props {
    eyebrow: string;
    headingId: string;
    isCentered?: boolean;
}

const { eyebrow, headingId, isCentered = false } = Astro.props;
---

<header
    class:list={['section-head', { 'section-head--center mx-auto text-center': isCentered }]}
    data-scroll
>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={headingId}>
        <slot />
    </h2>
    <slot name="text" />
</header>

<style>
    .section-head {
        margin-bottom: clamp(2rem, calc(1.5rem + 2.5vw), 3.5rem);
        max-width: var(--measure-prose);
    }

    .section-head h2 {
        font-size: var(--text-h2);
    }

    .section-head--center .eyebrow::before {
        display: none;
    }
</style>
