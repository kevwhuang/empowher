---
import Banner from '@sections/shared/Banner.astro';
import Hero from '@sections/shared/Hero.astro';
import Layout from '@/Layout.astro';
import Masonry from '@sections/gallery/Masonry.astro';
import { LINKS } from '@lib/constants';
---

<Layout
    description={'Photo gallery from EmpowHER Festival 2025 \u2014 ten hours of music and storytelling across Austin Garden Stage, IYKYK Rooftop, and The Studio in Austin, TX.'}
    title={'Gallery \u2014 EmpowHER Festival'}
>
    <Hero
        eyebrow="2025 in pictures"
        text={'A look back at EmpowHER 2025 \u2014 three stages, ten hours, and a whole lot of glitter.'}
    >
        The moments that <span class="text-holo">made it</span>
    </Hero>
    <Masonry />
    <Banner
        actions={[
            { href: '/info', label: 'Festival info' },
            { href: LINKS.instagram, isExternal: true, isGhost: true, label: 'More on Instagram' },
        ]}
        eyebrow="Be in the next batch"
        isTinted
        text={'April 17 \u00b7 12PM\u201310PM \u00b7 Austin Garden Stage. See you in the photos.'}
    >
        2027 will be even louder
    </Banner>
</Layout>
