---
import Banner from '@sections/shared/Banner.astro';
import Countdown from '@sections/home/Countdown.astro';
import Hero from '@sections/home/Hero.astro';
import Layout from '@/Layout.astro';
import Marquee from '@sections/shared/Marquee.astro';
import Pillars from '@sections/home/Pillars.astro';
import Press from '@sections/shared/Press.astro';
import Stages from '@sections/shared/Stages.astro';
import Stats from '@sections/home/Stats.astro';
import { LINKS } from '@lib/constants';
---

<Layout
    description={'A storytelling immersive music production that reminds you who TF you are. April 17, 2027 \u00b7 12PM\u201310PM \u00b7 Austin Garden Stage, Austin, TX.'}
    title="EmpowHER Festival"
>
    <Hero />
    <Marquee
        isLoud
        items={[
            'Remind you who TF you are',
            'Awaken your authenticity',
            'Empowering voices',
            'April 17 \u2014 Austin Garden Stage',
        ]}
    />
    <Countdown />
    <Pillars />
    <Stages />
    <Stats />
    <Press />
    <Marquee
        items={[
            LINKS.instagramHandle,
            'IYKYK Rooftop',
            'The Studio',
            'Austin Garden Stage',
            'Pop to EDM',
        ]}
    />
    <Banner
        actions={[
            { href: '/contact', label: 'Get in touch' },
            { href: LINKS.pitchDeck, isDownload: true, isGhost: true, label: 'Download pitch deck' },
        ]}
        eyebrow="Join the movement"
        text={'Sponsor, vend, perform, or volunteer \u2014 if you align with the mission to empower creatives and amplify genuine self-expression, we want you.'}
    >
        Inspire change. Become part of <span class="text-holo">HERstory</span>.
    </Banner>
</Layout>
