---
import CtaBanner from '@sections/CtaBanner.astro';
import HomeCountdown from '@sections/HomeCountdown.astro';
import HomeHero from '@sections/HomeHero.astro';
import HomePillars from '@sections/HomePillars.astro';
import HomeStats from '@sections/HomeStats.astro';
import Layout from '@/Layout.astro';
import Marquee from '@sections/Marquee.astro';
import PressWall from '@sections/PressWall.astro';
import Stages from '@sections/Stages.astro';
import { LINKS } from '@lib/constants';
---

<Layout
    description={'A storytelling immersive music production that reminds you who TF you are. April 17, 2027 \u00b7 12PM\u201310PM \u00b7 Austin Garden Stage, Austin, TX.'}
    title="EmpowHER Festival"
>
    <HomeHero />
    <Marquee
        isLoud
        items={[
            'Remind you who TF you are',
            'Awaken your authenticity',
            'Empowering voices',
            'April 17 \u2014 Austin Garden Stage',
        ]}
    />
    <HomeCountdown />
    <HomePillars />
    <Stages />
    <HomeStats />
    <PressWall />
    <Marquee
        items={[
            LINKS.instagramHandle,
            'IYKYK Rooftop',
            'The Studio',
            'Austin Garden Stage',
            'Pop to EDM',
        ]}
    />
    <CtaBanner
        eyebrow="Join the movement"
        text={'Sponsor, vend, perform, or volunteer \u2014 if you align with the mission to empower creatives and amplify genuine self-expression, we want you.'}
    >
        Inspire change. Become part of <span class="text-holo">HERstory</span>.
        <Fragment slot="actions">
            <a
                class="button button--large button--primary"
                href="/contact"
            >
                Get in touch
            </a>
            <a
                class="button button--ghost button--large"
                download
                href={LINKS.pitchDeck}
            >
                Download pitch deck
            </a>
        </Fragment>
    </CtaBanner>
</Layout>
