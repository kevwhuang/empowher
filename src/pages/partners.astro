---
import Banner from '@sections/shared/Banner.astro';
import Collectives from '@sections/partners/Collectives.astro';
import Hero from '@sections/shared/Hero.astro';
import Layout from '@/Layout.astro';
import Press from '@sections/shared/Press.astro';
import Sponsors from '@sections/partners/Sponsors.astro';
import Tiers from '@sections/partners/Tiers.astro';
import Wall from '@sections/partners/Wall.astro';
import Why from '@sections/partners/Why.astro';
import { LINKS } from '@lib/constants';
---

<Layout
    description={'Put your brand at the heart of EmpowHER Festival \u2014 sponsorship tiers, brand activations, and a proven 2025 track record of $10,000+ raised by a 20-person crew.'}
    title={'Partners & Sponsors \u2014 EmpowHER Festival'}
>
    <Hero
        actions={[
            { href: '/contact', label: 'Start a partnership' },
            { href: LINKS.pitchDeck, isDownload: true, isGhost: true, label: 'Download pitch deck' },
        ]}
        eyebrow="Brand partnerships"
        text={'EmpowHER is a sponsorship opportunity to reach Austin\'s most engaged creative community \u2014 and to stand for something while doing it.'}
    >
        Empower. Elevate. <span class="text-holo">Expand impact.</span>
    </Hero>
    <Why />
    <Tiers />
    <Wall />
    <Sponsors />
    <Collectives />
    <Press />
    <Banner
        actions={[{ href: '/contact', label: 'Become a sponsor' }]}
        eyebrow="Ready when you are"
        isTinted
        text={'Tell us about your brand and we\'ll shape a package that fits \u2014 booths, stage moments, podcast integrations, and more.'}
    >
        Let's build something <span class="text-holo">unforgettable</span>
    </Banner>
</Layout>
