---
import Hero from '@sections/shared/Hero.astro';
import Layout from '@/Layout.astro';
import Panel from '@sections/contact/Panel.astro';
import { LINKS } from '@lib/constants';
---

<Layout
    description={`Reach EmpowHER Festival \u2014 sponsorships, vending, performing, volunteering, press, and tickets. Email ${LINKS.email}.`}
    title={'Contact \u2014 EmpowHER Festival'}
>
    <Hero
        eyebrow="Say hi"
        text={'Sponsorships, vending, performing, volunteering, press, tickets \u2014 whatever brings you here, we want to hear it.'}
    >
        Let's make <span class="text-holo">HERstory</span> together
    </Hero>
    <Panel />
</Layout>
