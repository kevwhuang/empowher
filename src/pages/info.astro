---
import CtaBanner from '@sections/CtaBanner.astro';
import InfoFaq from '@sections/InfoFaq.astro';
import InfoSchedule from '@sections/InfoSchedule.astro';
import InfoVenue from '@sections/InfoVenue.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/PageHero.astro';
import Stages from '@sections/Stages.astro';
---

<Layout
    description={'EmpowHER Festival info for November 8, 2026 \u2014 three stages, the day-of schedule, directions to Austin Garden at Inn Cahoots, FAQ, and accessibility.'}
    title={'Festival Info \u2014 EmpowHER Festival'}
>
    <PageHero
        eyebrow="Festival info"
        text={'November 8 \u00b7 12PM\u201310PM \u00b7 Austin Garden at Inn Cahoots. Three stages, one immersive experience.'}
    >
        Know before <span class="text-holo">you glow</span>
    </PageHero>
    <Stages variant="info" />
    <InfoSchedule />
    <InfoVenue />
    <InfoFaq />
    <CtaBanner
        eyebrow="Still curious?"
        isTinted
        text={'Questions about tickets, accessibility, vending, or press \u2014 we answer fast.'}
    >
        Ask us anything
        <Fragment slot="actions">
            <a
                class="button button--large button--primary"
                href="/contact"
            >
                Contact us
            </a>
        </Fragment>
    </CtaBanner>
</Layout>
