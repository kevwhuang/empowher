---
import Banner from '@sections/shared/Banner.astro';
import Faq from '@sections/info/Faq.astro';
import Hero from '@sections/shared/Hero.astro';
import Layout from '@/Layout.astro';
import Schedule from '@sections/info/Schedule.astro';
import Stages from '@sections/shared/Stages.astro';
import Venue from '@sections/info/Venue.astro';
---

<Layout
    description={'EmpowHER Festival info for April 17, 2027 \u2014 three stages, the day-of schedule, directions to Austin Garden Stage at Inn Cahoots, FAQ, and accessibility.'}
    title={'Festival Info \u2014 EmpowHER Festival'}
>
    <Hero
        eyebrow="Festival info"
        text={'April 17 \u00b7 12PM\u201310PM \u00b7 Austin Garden Stage at Inn Cahoots. Three stages, one immersive experience.'}
    >
        Know before <span class="text-holo">you glow</span>
    </Hero>
    <Stages variant="info" />
    <Schedule />
    <Venue />
    <Faq />
    <Banner
        actions={[{ href: '/contact', label: 'Contact us' }]}
        eyebrow="Still curious?"
        isTinted
        text={'Questions about tickets, accessibility, vending, or press \u2014 we answer fast.'}
    >
        Ask us anything
    </Banner>
</Layout>
