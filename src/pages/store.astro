---
import CtaBanner from '@sections/CtaBanner.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/PageHero.astro';
import StoreGrid from '@sections/StoreGrid.astro';
import { LINKS } from '@lib/constants';
---

<Layout
    description={'The official EmpowHER Festival store \u2014 wear the movement and rep empowering voices ahead of April 17 at Austin Garden Stage.'}
    title={'Store \u2014 EmpowHER Festival'}
>
    <PageHero
        eyebrow="Merch"
        text="Official EmpowHER Festival merch."
    >
        Wear the <span class="text-holo">movement</span>
    </PageHero>
    <StoreGrid />
    <CtaBanner
        eyebrow="Questions?"
        isTinted
        text={'Questions about merch, sizing, or orders \u2014 reach out anytime.'}
    >
        We're happy to help
        <Fragment slot="actions">
            <a
                class="button button--large button--primary"
                href="/contact"
            >
                Contact us
            </a>
            <a
                class="button button--ghost button--large"
                href={LINKS.instagram}
                rel="noopener noreferrer"
                target="_blank"
            >
                DM on Instagram
            </a>
        </Fragment>
    </CtaBanner>
</Layout>
