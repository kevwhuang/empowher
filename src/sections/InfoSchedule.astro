---
import SectionHead from '@components/SectionHead.astro';

const SCHEDULE = [
    {
        datetime: '2027-04-17T12:00-05:00',
        description: 'Panelists kick off EmpowHER with stories of authenticity and resilience.',
        time: '12PM',
        title: 'Doors + Live Podcast Session',
        where: 'The Studio',
    },
    {
        description: 'Ecstatic dance, spoken word, tattoos, and immersive experiences.',
        time: 'Afternoon',
        title: 'Acoustic Sets, Tarot + Workshops',
        where: 'IYKYK Rooftop',
    },
    {
        description: 'Skyline views and sundown DJs before the headliners take over.',
        time: 'Sunset',
        title: 'Golden Hour Sets',
        where: 'IYKYK Rooftop',
    },
    {
        description: 'Flash mobs, LED + fire flow shows, and the night\'s biggest sets until 10PM.',
        time: 'Evening',
        title: 'Main Acts + DJ Headliners',
        where: 'Austin Garden Stage',
    },
];
---

<section
    class="section"
    aria-labelledby="info-schedule-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Day-of flow"
            headingId="info-schedule-title"
        >
            The shape of the day
            <p slot="text">Lineup and set times drop soon &mdash; here's how the day flows.</p>
        </SectionHead>
        <ol
            class="info-schedule grid gap-x-4 gap-y-3"
            data-scroll
            data-scroll-stagger
        >
            {SCHEDULE.map(row => (
                <li class="card info-schedule__row">
                    {row.datetime
                        ? (
                                <time
                                    class="font-bold font-display text-[0.875rem] text-purple-bright"
                                    datetime={row.datetime}
                                >
                                    {row.time}
                                </time>
                            )
                        : (
                                <span class="font-bold font-display text-[0.875rem] text-purple-bright">{row.time}</span>
                            )}
                    <div class="info-schedule__what min-w-0">
                        <h3>{row.title}</h3>
                        <p>{row.description}</p>
                    </div>
                    <span class="font-mono text-[0.75rem] tracking-[0.12em] uppercase text-cyan">{row.where}</span>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .info-schedule {
        grid-template-columns: 7.5rem minmax(min(100%, 12rem), 1fr) minmax(0, auto);
    }

    .info-schedule__row {
        align-items: center;
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        padding: 1rem 1.5rem;
    }

    .info-schedule__what h3 {
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .info-schedule__what p {
        font-size: 0.875rem;
    }

    @media (max-width: 48rem) {
        .info-schedule {
            grid-template-columns: minmax(0, 1fr);
        }

        .info-schedule__row {
            row-gap: 0.25rem;
        }
    }
</style>
