---
interface Props {
    isLoud?: boolean;
    items: string[];
}

const TRACK_COUNT = 6;

const { isLoud = false, items } = Astro.props;
---

<section
    class:list={['marquee', { 'marquee--loud': isLoud }]}
    aria-hidden="true"
>
    {Array.from({ length: TRACK_COUNT }, () => (
        <div class="marquee__track">
            {items.map(item => (
                <>
                    <span>{item}</span>
                    <span class="marquee__spark">&#x2726;</span>
                </>
            ))}
        </div>
    ))}
</section>

<style>
    .marquee {
        background: var(--color-ink-light);
        border-block: var(--border-soft);
        display: flex;
        overflow: hidden;
        padding-block: 1rem;
        user-select: none;
    }

    .marquee--loud {
        background: var(--color-purple);
        border-block: 0.125rem solid var(--color-ink);
    }

    .marquee--loud .marquee__spark {
        color: var(--color-paper);
    }

    .marquee--loud .marquee__track {
        color: var(--color-ink);
    }

    .marquee__spark {
        color: var(--color-pink);
    }

    .marquee__track {
        --marquee-gap: 2.5rem;
        align-items: center;
        animation: marquee__scroll 28s linear infinite;
        display: flex;
        flex-shrink: 0;
        font-family: var(--font-display);
        font-size: clamp(0.875rem, calc(0.75rem + 0.625vw), 1.25rem);
        font-weight: 700;
        gap: var(--marquee-gap);
        letter-spacing: 0.06em;
        padding-right: var(--marquee-gap);
        text-transform: uppercase;
        white-space: nowrap;
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee__track {
            animation: none;
        }
    }

    @keyframes marquee__scroll {
        to {
            transform: translateX(-100%);
        }
    }
</style>
