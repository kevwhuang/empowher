---
import CardPerson from '@components/CardPerson.astro';
import LogoWall from '@components/LogoWall.astro';
import SectionHead from '@components/SectionHead.astro';
import logoACristal from '@images/logos/a_cristal_experience.webp';
import logoAmplifyEdm from '@images/logos/amplify_edm.webp';
import logoBakedUp from '@images/logos/baked_up.webp';
import logoBpe from '@images/logos/bpe.webp';
import logoEdmProsperity from '@images/logos/edm_prosperity_network.webp';
import logoFitcidence from '@images/logos/fitcidence.webp';
import logoVenusCollective from '@images/logos/venus_collective.webp';
import logoWarriorWomen from '@images/logos/warrior_women.webp';
import photoDanielle from '@images/partners/danielle.webp';
import photoKay from '@images/partners/kay.webp';
import photoSaratonin from '@images/partners/saratonin.webp';
import photoSydney from '@images/partners/sydney.webp';

const COLLECTIVES = [
    { alt: 'A Cristal Experience', image: logoACristal },
    { alt: 'Amplify EDM', image: logoAmplifyEdm },
    { alt: 'BPE', image: logoBpe },
    { alt: 'Baked Up', image: logoBakedUp },
    { alt: 'EDM Prosperity Network', image: logoEdmProsperity },
    { alt: 'Fitcidence', image: logoFitcidence },
    { alt: 'Venus Collective', image: logoVenusCollective },
    { alt: 'Warrior Women', image: logoWarriorWomen },
];

const FOUNDERS = [
    { image: photoDanielle, name: 'Danielle', role: 'Founder, Warrior Women' },
    { image: photoKay, name: 'Kay', role: 'Founder, Amplify EDM' },
    { image: photoSaratonin, name: 'Saratonin', role: 'Founder, EDM Prosperity Network' },
    { image: photoSydney, name: 'Sydney', role: 'Founder, Baked Up' },
];
---

<section
    class="section section--tint"
    aria-labelledby="partners-collectives-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="A growing movement"
            headingId="partners-collectives-title"
        >
            In cahoots with Austin's collectives
            <p slot="text">Madewell Productions builds space for Austin's community of leading creative organizations.</p>
        </SectionHead>
        <ul
            class="flex flex-wrap justify-center gap-5 mb-8 list-none"
            data-scroll
            data-scroll-stagger
        >
            {FOUNDERS.map(founder => <CardPerson image={founder.image} name={founder.name} role={founder.role} />)}
        </ul>
        <LogoWall logos={COLLECTIVES} />
    </div>
</section>
