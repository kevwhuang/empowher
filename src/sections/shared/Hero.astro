---
interface Props {
    actions?: Action[];
    eyebrow: string;
    text?: string;
}

const { actions = [], eyebrow, text } = Astro.props;
---

<section
    class="page-hero"
    aria-labelledby="page-hero-title"
>
    <div
        class="shell relative"
        data-scroll
        data-scroll-stagger
    >
        <p class="eyebrow">{eyebrow}</p>
        <h1 id="page-hero-title">
            <slot />
        </h1>
        {text && (
            <p class="page-hero__text max-w-(--measure-prose) text-[1.25rem] text-lavender">{text}</p>
        )}
        {actions.length > 0 && (
            <div class="page-hero__actions flex flex-wrap gap-4">
                {actions.map(action => (
                    <a
                        class:list={['button', action.isGhost ? 'button--ghost' : 'button--primary']}
                        download={action.isDownload}
                        href={action.href}
                        rel={action.isExternal ? 'noopener noreferrer' : undefined}
                        target={action.isExternal ? '_blank' : undefined}
                    >
                        {action.label}
                    </a>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .page-hero {
        --spacing-section: clamp(4rem, calc(3.17rem + 4.17vw), 6.5rem);
        overflow: clip;
        padding-bottom: clamp(2.5rem, calc(2rem + 2.5vw), 4rem);
        position: relative;
    }

    .page-hero::before {
        background:
            radial-gradient(40% 55% at 18% 30%, var(--color-purple-20), transparent 70%),
            radial-gradient(35% 50% at 82% 20%, var(--color-pink-15), transparent 70%),
            radial-gradient(30% 45% at 55% 80%, var(--color-cyan-10), transparent 70%);
        content: '';
        height: 130%;
        inset: -30% -10% auto;
        pointer-events: none;
        position: absolute;
    }

    .page-hero .shell > :last-child {
        margin-bottom: 0;
    }

    .page-hero h1 {
        font-size: var(--text-hero);
        font-weight: 900;
        max-width: 1088px;
    }

    .page-hero__text:has(+ .page-hero__actions) {
        margin-bottom: 2.5rem;
    }
</style>
