---
import { Image } from 'astro:assets';

import logoEmpowher from '@images/logos/empowher_festival.webp';
import poster from '@images/poster.webp';
---

<section
    class="home-hero grid overflow-clip place-items-center relative isolate min-h-svh text-center"
    aria-labelledby="home-hero-title"
>
    <div
        class="home-hero__media -z-1"
        aria-hidden="true"
    >
        <video
            class="object-cover h-full w-full"
            autoplay
            loop
            muted
            playsinline
            poster={poster.src}
        >
            <source src="/videos/hero.webm" type="video/webm" />
        </video>
    </div>
    <div
        class="shell relative"
        data-scroll
        data-scroll-stagger
    >
        <h1 id="home-hero-title">
            <Image
                class="home-hero__logo"
                alt="EmpowHER Festival"
                densities={[1, 2]}
                fetchpriority="high"
                loading="eager"
                src={logoEmpowher}
                width={640}
            />
        </h1>
        <p class="home-hero__tagline">
            A storytelling immersive music production that reminds you <strong>who TF you are</strong>. Empowering voices.
        </p>
        <ul class="home-hero__meta list-none">
            <li><time datetime="2026-11-08">November 8</time></li>
            <li
                class="text-pink"
                aria-hidden="true"
            >
                &#x2726;
            </li>
            <li><time datetime="2026-11-08T12:00-06:00">12PM</time>&ndash;<time datetime="2026-11-08T22:00-06:00">10PM</time></li>
            <li
                class="text-pink"
                aria-hidden="true"
            >
                &#x2726;
            </li>
            <li>Austin Garden</li>
        </ul>
        <p class="home-hero__spaces">
            Garden Stage &middot; IYKYK Rooftop &middot; The Studio
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a
                class="button button--large button--primary"
                href="/contact"
            >
                Become a sponsor
            </a>
            <a
                class="button button--ghost button--large"
                href="/info"
            >
                Explore the festival
            </a>
        </div>
    </div>
</section>

<style>
    .home-hero {
        --spacing-section: clamp(3.5rem, calc(2.67rem + 4.17vw), 6rem);
        padding-bottom: var(--spacing-section);
    }

    .home-hero h1 {
        --home-hero-logo-width: min(40rem, 74.6vw);
        margin-bottom: calc(1.5rem + var(--home-hero-logo-width) * 0.1413);
        padding-top: calc(var(--home-hero-logo-width) * 0.107);
        user-select: none;
    }

    .home-hero__logo {
        filter: drop-shadow(0 0.8rem 2.5rem var(--color-purple-45));
        margin-inline: auto;
        width: var(--home-hero-logo-width);
    }

    .home-hero__media {
        background:
            radial-gradient(60% 80% at 25% 25%, var(--color-purple-40), transparent 65%),
            radial-gradient(55% 70% at 78% 30%, var(--color-pink-25), transparent 65%),
            radial-gradient(50% 65% at 50% 90%, var(--color-cyan-20), transparent 65%),
            var(--color-ink);
        inset: 0;
        position: absolute;
    }

    .home-hero__media::after {
        background: linear-gradient(180deg, var(--color-ink-55), var(--color-ink-80) 80%, var(--color-ink));
        content: '';
        inset: 0;
        position: absolute;
    }

    .home-hero__meta {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        font-family: var(--font-display);
        font-size: 0.875rem;
        font-weight: 700;
        gap: 0.5rem 1rem;
        justify-content: center;
        letter-spacing: 0.05em;
        margin-bottom: 1em;
        text-transform: uppercase;
    }

    .home-hero__spaces {
        color: var(--color-cyan);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        letter-spacing: 0.14em;
        margin-bottom: 2.5rem;
        text-transform: uppercase;
    }

    .home-hero__tagline {
        font-size: clamp(1rem, calc(0.92rem + 0.42vw), 1.25rem);
        font-weight: 500;
        margin-bottom: 1.5rem;
        margin-inline: auto;
        max-width: 40rem;
    }

    .home-hero__tagline strong {
        color: var(--color-purple);
    }
</style>

<script>
    import { REDUCED_MOTION_QUERY } from '@lib/constants';
    import { registerPageScript } from '@lib/utils';

    const reducedMotionQuery = window.matchMedia(REDUCED_MOTION_QUERY);

    function initHeroVideo(signal: AbortSignal) {
        syncHeroVideo(reducedMotionQuery.matches);
        reducedMotionQuery.addEventListener('change', event => syncHeroVideo(event.matches), { signal });
    }

    function syncHeroVideo(prefersReducedMotion: boolean) {
        const video = document.querySelector<HTMLVideoElement>('.home-hero__media video');

        if (!prefersReducedMotion || !video) return;

        video.removeAttribute('autoplay');
        video.pause();
        video.load();
    }

    registerPageScript(initHeroVideo);
</script>
