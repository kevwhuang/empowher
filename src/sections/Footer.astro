---
import { Image } from 'astro:assets';

import logoEmpowher from '@images/logos/empowher_festival.webp';
import logoMadewell from '@images/logos/madewell_productions.webp';
import { LINKS, ROUTES } from '@lib/constants';

const CREDIT_URL = 'https://instagram.com/aephonics';
---

<footer class="site-footer">
    <span class="holo-bar -top-[0.1875rem] inset-x-0" aria-hidden="true" />
    <div class="shell">
        <div class="site-footer__grid grid mb-10">
            <div class="pt-2">
                <Image
                    class="h-10 w-auto mb-7 select-none"
                    alt="EmpowHER Festival"
                    densities={[1, 2]}
                    src={logoEmpowher}
                    width={127}
                />
                <p class="max-w-[24rem] text-[0.875rem] text-lavender">A storytelling immersive music production that reminds you who TF you are. One day, three stages, ten hours &mdash; <time datetime="2027-04-17">April 17, 2027</time>, <time datetime="2027-04-17T12:00-05:00">12PM</time> to <time datetime="2027-04-17T22:00-05:00">10PM</time> at the Austin Garden at Inn Cahoots in Austin, TX. Empowering voices, awakening authenticity.</p>
            </div>
            <div>
                <h2 class="site-footer__heading">Explore</h2>
                <ul class="grid gap-2">
                    {ROUTES.map(route => (
                        <li><a href={route.href}>{route.label}</a></li>
                    ))}
                </ul>
            </div>
            <div>
                <h2 class="site-footer__heading">Connect</h2>
                <ul class="grid gap-2">
                    <li><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></li>
                    <li>
                        <a
                            href={LINKS.instagram}
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            {LINKS.instagramHandle}
                        </a>
                    </li>
                </ul>
            </div>
            <div>
                <h2 class="site-footer__heading">Assets</h2>
                <ul class="grid gap-2">
                    <li>
                        <a
                            download
                            href={LINKS.pitchDeck}
                        >
                            Pitch deck
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="site-footer__legal">
            <p>&copy; 2026 EmpowHER Festival.</p>
            <nav
                class="inline-flex gap-4"
                aria-label="Legal"
            >
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </nav>
            <a
                href={CREDIT_URL}
                rel="noopener noreferrer"
                target="_blank"
            >
                Made by @aephonics
            </a>
            <p class="inline-flex items-center gap-2">
                Directed by Anna Madewell
                <Image
                    class="h-[1.9rem] w-auto invert opacity-[0.85] select-none"
                    alt="Madewell Productions"
                    densities={[1, 2]}
                    src={logoMadewell}
                    width={43}
                />
            </p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--color-ink-light);
        border-top: var(--border-soft);
        padding: clamp(3rem, calc(2.5rem + 2.5vw), 4.5rem) 0 2rem;
        position: relative;
    }

    .site-footer a {
        color: var(--color-lavender);
        text-decoration: none;
        transition:
            color var(--duration-fast) ease,
            opacity var(--duration-fast) ease;
    }

    .site-footer a:active {
        opacity: 0.7;
    }

    .site-footer a:hover {
        color: var(--color-purple-bright);
    }

    .site-footer li {
        min-width: 0;
    }

    .site-footer li a {
        position: relative;
    }

    .site-footer li a::after {
        content: '';
        inset: -0.375rem -0.75rem;
        position: absolute;
    }

    .site-footer__grid {
        gap: clamp(2rem, calc(1.33rem + 3.33vw), 4rem);
        grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }

    .site-footer__grid > div {
        min-width: 0;
    }

    .site-footer__heading {
        color: var(--color-paper);
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .site-footer__legal {
        align-items: center;
        border-top: var(--border-soft);
        color: var(--color-lavender);
        display: flex;
        flex-wrap: wrap;
        font-size: 0.875rem;
        gap: 1.75rem;
        justify-content: space-between;
        padding-top: 1.5rem;
    }

    .site-footer__legal > * {
        min-width: 0;
    }

    .site-footer__legal a {
        position: relative;
    }

    .site-footer__legal a::after {
        content: '';
        inset: -0.8125rem -0.3125rem;
        position: absolute;
    }

    .site-footer__legal p {
        margin-bottom: 0;
    }

    @media (max-width: 64rem) {
        .site-footer__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 48rem) {
        .site-footer__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
