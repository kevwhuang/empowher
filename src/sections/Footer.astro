---
import { Image } from 'astro:assets';

import logoEmpowher from '@images/logos/empowher_festival.webp';
import logoMadewell from '@images/logos/madewell_productions.webp';
import { LINKS, ROUTES } from '@lib/constants';

const CREDIT_URL = 'https://instagram.com/aephonics';
---

<footer class="site-footer">
    <span class="holo-bar -top-[0.1875rem] inset-x-0" aria-hidden="true" />
    <div class="shell">
        <div class="site-footer__grid grid mb-10">
            <div class="pt-2">
                <Image
                    class="h-10 w-auto mb-7 select-none"
                    alt="EmpowHER Festival"
                    densities={[1, 2]}
                    src={logoEmpowher}
                    width={127}
                />
                <p class="max-w-[24rem] text-[0.875rem] text-lavender">A storytelling immersive music production that reminds you who TF you are. One day, three stages, ten hours &mdash; <time datetime="2026-11-08">November 8, 2026</time>, <time datetime="2026-11-08T12:00-06:00">12PM</time> to <time datetime="2026-11-08T22:00-06:00">10PM</time> at the Austin Garden at Inn Cahoots in Austin, TX. Empowering voices, awakening authenticity.</p>
            </div>
            <div>
                <h2 class="site-footer__heading">Explore</h2>
                <ul class="grid gap-2">
                    {ROUTES.map(route => (
                        <li><a href={route.href}>{route.label}</a></li>
                    ))}
                </ul>
            </div>
            <div>
                <h2 class="site-footer__heading">Connect</h2>
                <ul class="grid gap-2">
                    <li><a href={`mailto:${LINKS.email}`}>{LINKS.email}</a></li>
                    <li>
                        <a
                            href={LINKS.instagram}
                            rel="noopener noreferrer"
                            target="_blank"
                        >
                            Instagram &mdash; {LINKS.instagramHandle}
                        </a>
                    </li>
                    <li>
                        <a
                            aria-disabled="true"
                            href={LINKS.website}
                            tabindex="-1"
                        >
                            {LINKS.websiteLabel}
                        </a>
                    </li>
                </ul>
            </div>
            <div>
                <h2 class="site-footer__heading">Assets</h2>
                <ul class="grid gap-2">
                    <li>
                        <a
                            download
                            href={LINKS.pitchDeck}
                        >
                            Pitch deck
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <p class="site-footer__notice">
            <span class="site-footer__notice-tag">Heads up</span>
            <span>This site is still a work in progress. Last updated <time datetime="2026-07-29">July 29, 2026</time>.</span>
        </p>
        <div class="site-footer__legal">
            <p>&copy; 2026 EmpowHER Festival. All rights reserved.</p>
            <nav
                class="inline-flex gap-4"
                aria-label="Legal"
            >
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </nav>
            <a
                href={CREDIT_URL}
                rel="noopener noreferrer"
                target="_blank"
            >
                Made by @aephonics
            </a>
            <p class="inline-flex items-center gap-2">
                Directed by Anna Madewell
                <Image
                    class="h-[1.9rem] w-auto invert opacity-[0.85] select-none"
                    alt="Madewell Productions"
                    densities={[1, 2]}
                    src={logoMadewell}
                    width={43}
                />
            </p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--color-ink-light);
        border-top: var(--border-soft);
        padding: clamp(3rem, calc(2.5rem + 2.5vw), 4.5rem) 0 2rem;
        position: relative;
    }

    .site-footer a {
        color: var(--color-lavender);
        text-decoration: none;
        transition:
            color var(--duration-fast) ease,
            opacity var(--duration-fast) ease;
    }

    .site-footer a:active {
        opacity: 0.7;
    }

    .site-footer a:hover {
        color: var(--color-purple-bright);
    }

    .site-footer a[aria-disabled='true'] {
        color: var(--color-lavender);
        cursor: not-allowed;
        opacity: 0.45;
    }

    .site-footer a[aria-disabled='true']:active {
        color: var(--color-lavender);
        opacity: 0.45;
    }

    .site-footer a[aria-disabled='true']:hover {
        color: var(--color-lavender);
    }

    .site-footer li {
        min-width: 0;
    }

    .site-footer li a {
        position: relative;
    }

    .site-footer li a::after {
        content: '';
        inset: -0.375rem -0.75rem;
        position: absolute;
    }

    .site-footer__grid {
        gap: clamp(2rem, calc(1.33rem + 3.33vw), 4rem);
        grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }

    .site-footer__grid > div {
        min-width: 0;
    }

    .site-footer__heading {
        color: var(--color-paper);
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
        text-transform: uppercase;
    }

    .site-footer__legal {
        align-items: center;
        border-top: var(--border-soft);
        color: var(--color-lavender);
        display: flex;
        flex-wrap: wrap;
        font-size: 0.875rem;
        gap: 1.75rem;
        justify-content: space-between;
        padding-top: 1.5rem;
    }

    .site-footer__legal > * {
        min-width: 0;
    }

    .site-footer__legal a {
        position: relative;
    }

    .site-footer__legal a::after {
        content: '';
        inset: -0.8125rem -0.3125rem;
        position: absolute;
    }

    .site-footer__legal p {
        margin-bottom: 0;
    }

    .site-footer__notice {
        align-items: center;
        background: var(--color-purple-10);
        border: 0.0625rem solid var(--color-purple-35);
        border-radius: var(--radius-card-sm);
        color: var(--color-lavender);
        display: flex;
        flex-wrap: wrap;
        font-size: 0.875rem;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
        padding: 0.75rem 1.25rem;
    }

    .site-footer__notice-tag {
        background: var(--color-purple-15);
        border-radius: var(--radius-pill);
        color: var(--color-purple-bright);
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        padding: 0.3em 0.9em;
        text-transform: uppercase;
    }

    @media (max-width: 64rem) {
        .site-footer__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 48rem) {
        .site-footer__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { initDisabledLinks, registerPageScript } from '@lib/utils';

    function initFooter(signal: AbortSignal) {
        initDisabledLinks('.site-footer a[aria-disabled="true"]', signal);
    }

    registerPageScript(initFooter);
</script>
