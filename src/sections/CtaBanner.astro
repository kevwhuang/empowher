---
interface Props {
    eyebrow: string;
    isTinted?: boolean;
    text: string;
}

const { eyebrow, isTinted = false, text } = Astro.props;
---

<section
    class:list={['section', { 'section--tint': isTinted }]}
    aria-labelledby="cta-banner-title"
>
    <div class="shell">
        <div
            class="cta-banner overflow-clip relative text-center bg-ink-light"
            data-scroll="scale"
        >
            <p class="eyebrow">{eyebrow}</p>
            <h2 id="cta-banner-title">
                <slot />
            </h2>
            <p>{text}</p>
            <div class="cta-banner__actions flex flex-wrap justify-center gap-4">
                <slot name="actions" />
            </div>
        </div>
    </div>
</section>

<style>
    .cta-banner {
        border: var(--border-soft);
        border-radius: calc(var(--radius-card) * 1.4);
        padding: clamp(3.5rem, calc(2.67rem + 4.17vw), 6rem) var(--gutter);
    }

    .cta-banner::before {
        animation: cta-banner__rotate 14s linear infinite;
        background: var(--gradient-holo);
        content: '';
        filter: blur(3.75rem);
        inset: -40%;
        opacity: 0.16;
        position: absolute;
    }

    .cta-banner > * {
        position: relative;
    }

    .cta-banner h2 {
        font-size: var(--text-h2);
        margin-inline: auto;
        max-width: 976px;
    }

    .cta-banner p {
        color: var(--color-lavender);
        margin-inline: auto;
        max-width: var(--measure-narrow);
    }

    .cta-banner p:has(+ .cta-banner__actions) {
        margin-bottom: 2rem;
    }

    @keyframes cta-banner__rotate {
        to {
            transform: rotate(1turn);
        }
    }
</style>
