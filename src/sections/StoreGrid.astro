---
const PRODUCT_COUNT = 10;
---

<section
    class="section"
    aria-labelledby="store-grid-title"
>
    <div class="shell">
        <h2
            id="store-grid-title"
            class="sr-only"
        >
            Products
        </h2>
        <ul
            class="store-grid grid grid-cols-[repeat(auto-fill,minmax(min(100%,15rem),1fr))] gap-5 list-none"
            data-scroll
            data-scroll-stagger
        >
            {Array.from({ length: PRODUCT_COUNT }).map(() => (
                <li class="card card--subgrid store-grid__product">
                    <div
                        class="placeholder aspect-square"
                        aria-hidden="true"
                    >
                        <span>[Photo placeholder]</span>
                    </div>
                    <h3>[Product placeholder]</h3>
                    <p>[Description placeholder]</p>
                    <p class="store-grid__product-price">[Price placeholder]</p>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .store-grid__product {
        --card-rows: 4;
        --store-grid-pad: 1.25rem;
        overflow: clip;
        padding: 0 var(--store-grid-pad) 1.5rem;
        row-gap: 0.25rem;
    }

    .store-grid__product .placeholder {
        border: 0;
        border-bottom: var(--border-soft);
        border-radius: 0;
        margin-bottom: calc(var(--store-grid-pad) - 0.25rem);
        margin-inline: calc(var(--store-grid-pad) * -1);
    }

    .store-grid__product .store-grid__product-price {
        color: var(--color-purple-bright);
        font-family: var(--font-display);
        font-weight: 700;
        padding-top: 0.5rem;
    }

    .store-grid__product h3 {
        font-size: 1rem;
        margin-bottom: 0;
    }
</style>
