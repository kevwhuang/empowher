---
const PRODUCT_COUNT = 9;
---

<section
    class="section"
    aria-labelledby="store-grid-title"
>
    <div class="shell">
        <h2
            id="store-grid-title"
            class="sr-only"
        >
            Products
        </h2>
        <ul
            class="grid grid-cols-3 gap-5 list-none max-lg:grid-cols-2 max-md:grid-cols-1"
            data-scroll
            data-scroll-stagger
        >
            {Array.from({ length: PRODUCT_COUNT }).map(() => (
                <li
                    class="placeholder aspect-square"
                    aria-hidden="true"
                />
            ))}
        </ul>
    </div>
</section>
