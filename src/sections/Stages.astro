---
import type { ImageMetadata } from 'astro';

import { Image } from 'astro:assets';

import SectionHead from '@components/SectionHead.astro';
import logoAustinGarden from '@images/logos/inn_cahoots_garden.webp';
import logoIykyk from '@images/logos/inn_cahoots_iykyk_rooftop.webp';
import logoStudio from '@images/logos/inn_cahoots_studio.webp';
import photoAustinGarden from '@images/stages/austin_garden_stage.webp';
import photoIykyk from '@images/stages/iykyk_rooftop.webp';
import photoStudio from '@images/stages/the_studio.webp';

interface Props {
    variant?: 'home' | 'info';
}

interface Stage {
    descriptions: { home: string; info?: string };
    isInverted?: boolean;
    logo: ImageMetadata;
    logoAlt: string;
    logoHeight: string;
    name: string;
    photo: ImageMetadata;
    photoAlt: string;
    vibe: string;
    width: number;
}

const STAGES: Stage[] = [
    {
        descriptions: {
            home: 'Main acts + DJ headliners',
        },
        logo: logoAustinGarden,
        logoAlt: 'Austin Garden Stage \u2014 Inn Cahoots',
        logoHeight: '2.6rem',
        name: 'Austin Garden Stage',
        photo: photoAustinGarden,
        photoAlt: 'Aerial view of the Austin Garden Stage at sunset',
        vibe: 'Vibe: High-energy \u00b7 Open-air \u00b7 Peak visibility',
        width: 42,
    },
    {
        descriptions: {
            home: 'Rooftop home of acoustic acts \u00b7 tattoos \u00b7 tarot \u00b7 immersive experiences',
            info: 'Acoustic acts \u00b7 Tattoos \u00b7 Tarot \u00b7 Sunset sets \u00b7 Skyline views \u00b7 Immersive experiences',
        },
        isInverted: true,
        logo: logoIykyk,
        logoAlt: 'IYKYK Rooftop \u2014 Inn Cahoots',
        logoHeight: '1.37rem',
        name: 'IYKYK Rooftop',
        photo: photoIykyk,
        photoAlt: 'IYKYK Rooftop lounge overlooking the Austin skyline at sunset',
        vibe: 'Vibe: Mystical \u00b7 Intimate \u00b7 Golden hour',
        width: 45,
    },
    {
        descriptions: {
            home: 'Podcasts \u00b7 Comedians \u00b7 Live bands \u00b7 Solo artists',
            info: 'Podcasts \u00b7 Comedians \u00b7 Live bands \u00b7 Solo artists \u00b7 Storytelling brands',
        },
        isInverted: true,
        logo: logoStudio,
        logoAlt: 'The Studio \u2014 Inn Cahoots',
        logoHeight: '1.69rem',
        name: 'The Studio',
        photo: photoStudio,
        photoAlt: 'The Studio bar and lounge',
        vibe: 'Vibe: Intimate \u00b7 Conversational \u00b7 Content-driven',
        width: 63,
    },
];

const { variant = 'home' } = Astro.props;

const isInfo = variant === 'info';
---

<section
    class:list={['section', { 'section--tint': isInfo }, 'stages', { 'stages--info': isInfo }]}
    aria-labelledby="stages-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="The spaces"
            headingId="stages-title"
        >
            Three stages. One immersive experience.
        </SectionHead>
        <ul
            class:list={['grid grid-cols-[repeat(auto-fit,minmax(min(100%,17rem),1fr))] gap-5', { 'mb-8': !isInfo }, 'list-none']}
            data-scroll
            data-scroll-stagger
        >
            {STAGES.map(stage => (
                <li class="card card--subgrid stages__card">
                    <div class="stages__card-photo aspect-video">
                        <Image
                            class="object-cover h-full w-full"
                            alt={stage.photoAlt}
                            loading="lazy"
                            sizes="(min-width: 768px) 33vw, 100vw"
                            src={stage.photo}
                            widths={[360, 720]}
                        />
                    </div>
                    <h3>{stage.name}</h3>
                    <p>{stage.descriptions[variant] ?? stage.descriptions.home}</p>
                    <p class="stages__card-vibe">{stage.vibe}</p>
                    {isInfo && (
                        <Image
                            class:list={['stages__card-logo object-contain w-auto', { 'invert opacity-[0.92]': stage.isInverted }]}
                            alt={stage.logoAlt}
                            densities={[1, 2]}
                            loading="lazy"
                            src={stage.logo}
                            style={`--stages-logo-height: ${stage.logoHeight};`}
                            width={stage.width}
                        />
                    )}
                </li>
            ))}
        </ul>
        {!isInfo && (
            <p data-scroll>
                <a
                    class="button button--ghost"
                    href="/info"
                >
                    Full festival info
                </a>
            </p>
        )}
    </div>
</section>

<style>
    .stages .button::after {
        content: '\2192';
        content: '\2192' / '';
    }

    .stages .shell > p {
        margin-bottom: 0;
    }

    .stages--info .stages__card {
        --card-rows: 5;
    }

    .stages__card {
        --card-rows: 4;
        --stages-card-pad: clamp(1.25rem, calc(1.08rem + 0.83vw), 1.75rem);
        overflow: clip;
        padding: 0 var(--stages-card-pad) var(--stages-card-pad);
        row-gap: 0.5rem;
    }

    .stages__card .stages__card-logo {
        align-self: center;
        height: var(--stages-logo-height);
    }

    .stages__card .stages__card-vibe {
        color: var(--color-yellow);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .stages__card-photo {
        border-bottom: var(--border-soft);
        margin-bottom: calc(var(--stages-card-pad) - 0.5rem);
        margin-inline: calc(var(--stages-card-pad) * -1);
    }
</style>
