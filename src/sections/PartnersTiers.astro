---
import SectionHead from '@components/SectionHead.astro';

const TIERS = [
    {
        benefits: [
            'Logo on site + festival signage',
            'Social media shout-outs',
            'Vendor booth option',
        ],
        name: 'The Spark',
        tag: 'Supporter',
        tagModifier: 'card__tag--cyan',
    },
    {
        benefits: [
            'Everything in The Spark',
            'Stage naming + MC mentions',
            'Logo on screens between sets',
            'Branded activation space',
        ],
        isFeatured: true,
        name: 'The Amplifier',
        tag: 'Most popular',
        tagModifier: 'card__tag--pink',
    },
    {
        benefits: [
            'Everything in The Amplifier',
            'Presenting sponsor billing',
            'Live podcast segment integration',
            'First right of renewal for next year',
        ],
        name: 'The Powerhouse',
        tag: 'Headline',
        tagModifier: 'card__tag--yellow',
    },
];
---

<section
    class="section"
    aria-labelledby="partners-tiers-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Sponsorship tiers"
            headingId="partners-tiers-title"
        >
            Pick your level of loud
            <p slot="text">Custom packages available &mdash; these are starting points, not boxes.</p>
        </SectionHead>
        <ul
            class="partners-tiers grid grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))] gap-5 list-none"
            data-scroll
            data-scroll-stagger
        >
            {TIERS.map(tier => (
                <li class:list={['card card--subgrid partners-tiers__tier', { 'partners-tiers__tier--featured': tier.isFeatured }]}>
                    <span class:list={['card__tag', tier.tagModifier]}>{tier.tag}</span>
                    <h3>{tier.name}</h3>
                    <p class="partners-tiers__tier-price">Inquire</p>
                    <ul class="content-start grid gap-2 mb-8 text-[0.875rem] text-lavender">
                        {tier.benefits.map(benefit => (
                            <li>{benefit}</li>
                        ))}
                    </ul>
                    <a
                        class:list={['button', tier.isFeatured ? 'button--primary' : 'button--ghost']}
                        href="/contact"
                    >
                        Inquire
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .partners-tiers__tier {
        --card-rows: 5;
    }

    .partners-tiers__tier .card__tag {
        justify-self: stretch;
        margin-bottom: 1.5rem;
    }

    .partners-tiers__tier .partners-tiers__tier-price {
        color: var(--color-purple);
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 900;
        margin-bottom: 1rem;
    }

    .partners-tiers__tier h3 {
        margin-bottom: calc(0.6em + 0.5rem);
    }

    .partners-tiers__tier li {
        align-items: baseline;
        display: flex;
        gap: 0.6em;
    }

    .partners-tiers__tier li::before {
        color: var(--color-pink);
        content: '\2726';
        content: '\2726' / '';
        flex-shrink: 0;
    }

    .partners-tiers__tier--featured {
        border-color: var(--color-purple-65);
        box-shadow: var(--shadow-glow-purple);
    }
</style>
