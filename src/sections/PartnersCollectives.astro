---
import SectionHead from '@components/SectionHead.astro';

const COLLECTIVES = [
    'Amplify EDM',
    'Baked Up',
    'EDM Prosperity Network',
    'The Dance Academy',
    'Warrior Women',
] as const;
---

<section
    class="section"
    aria-labelledby="partners-collectives-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="A growing movement"
            headingId="partners-collectives-title"
        >
            In cahoots with Austin's collectives
            <p slot="text">Madewell Productions builds space for Austin's community of leading creative organizations.</p>
        </SectionHead>
        <ul
            class="partners-collectives flex flex-wrap gap-3"
            data-scroll
            data-scroll-stagger
        >
            {COLLECTIVES.map(name => (
                <li class="partners-collectives__item">{name}</li>
            ))}
        </ul>
    </div>
</section>

<style>
    .partners-collectives__item {
        background: var(--color-ink-light);
        border: var(--border-soft);
        border-radius: var(--radius-pill);
        font-family: var(--font-display);
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.7em 1.4em;
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .partners-collectives__item:hover {
        border-color: var(--color-pink);
        color: var(--color-pink);
        transform: translateY(-0.2rem) rotate(-1.5deg);
    }
</style>
