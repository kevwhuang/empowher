---
const TILE_RATIOS = ['aspect-[4/5]', 'aspect-video', 'aspect-square', 'aspect-[4/3]'] as const;

const TILE_TINTS = [
    'var(--color-purple-15)',
    'var(--color-pink-15)',
    'var(--color-cyan-10)',
    'var(--color-ink-55)',
    'transparent',
] as const;

const tiles = Array.from({ length: TILE_RATIOS.length * TILE_TINTS.length }, (_, index) => ({
    aspect: TILE_RATIOS[index % TILE_RATIOS.length],
    tint: TILE_TINTS[index % TILE_TINTS.length],
}));
---

<section
    class="section"
    aria-labelledby="gallery-masonry-title"
>
    <div class="shell">
        <h2
            id="gallery-masonry-title"
            class="sr-only"
        >
            Photo gallery
        </h2>
        <ul
            class="gallery-masonry columns-4 gap-x-3 list-none"
            data-scroll="scale"
            data-scroll-stagger="0.066"
        >
            {tiles.map(tile => (
                <li class:list={['gallery-masonry__tile', 'placeholder', tile.aspect, 'break-inside-avoid', 'mb-3']} aria-hidden="true" style={`--gallery-masonry-tint: ${tile.tint};`} />
            ))}
        </ul>
    </div>
</section>

<style>
    .gallery-masonry__tile {
        border-radius: var(--radius-card-sm);
        min-height: 0;
    }

    .gallery-masonry__tile::after {
        background: var(--gallery-masonry-tint);
        content: '';
        inset: 0;
        position: absolute;
    }

    @media (max-width: 64rem) {
        .gallery-masonry {
            column-count: 3;
        }

        .gallery-masonry__tile:nth-child(n + 16) {
            display: none;
        }
    }

    @media (max-width: 48rem) {
        .gallery-masonry {
            column-count: 2;
        }

        .gallery-masonry__tile:nth-child(n + 11) {
            display: none;
        }
    }
</style>
