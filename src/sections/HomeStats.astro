---
import SectionHead from '@components/SectionHead.astro';

const STATS = [
    { countTo: '10', label: 'Cash sponsorships + ticket revenue generated', prefix: '$', suffix: 'K+' },
    { countTo: '40', label: 'Operational team members', suffix: '+' },
    { countTo: '3', label: 'Stages, one immersive experience' },
    { countTo: '10', label: 'Hours of nonstop programming' },
];
---

<section
    class="section section--tint"
    aria-labelledby="home-stats-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Receipts"
            headingId="home-stats-title"
            isCentered
        >
            Built different. <span class="text-holo">Proven loud.</span>
        </SectionHead>
        <dl
            class="home-stats grid grid-cols-[repeat(auto-fit,minmax(min(100%,13rem),1fr))] gap-5"
            data-scroll="scale"
            data-scroll-stagger
        >
            {STATS.map(stat => (
                <div class="home-stats__item">
                    <dt class="text-[0.875rem] text-lavender">{stat.label}</dt>
                    <dd
                        class="home-stats__number"
                        data-count-to={stat.countTo}
                        data-prefix={stat.prefix}
                        data-suffix={stat.suffix}
                    >
                        {stat.prefix}0
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .home-stats__item {
        background: var(--color-ink-lighter);
        border: var(--border-soft);
        border-radius: var(--radius-card);
        display: flex;
        flex-direction: column-reverse;
        gap: 0.5rem;
        padding: clamp(1.5rem, calc(1.17rem + 1.67vw), 2.5rem) 1.25rem;
        text-align: center;
    }

    .home-stats__number {
        font-family: var(--font-display);
        font-size: clamp(2rem, calc(1.67rem + 1.67vw), 3rem);
        font-variant-numeric: tabular-nums;
        font-weight: 900;
        line-height: 1.1;
    }
</style>
