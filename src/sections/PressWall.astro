---
import LogoWall from '@components/LogoWall.astro';
import SectionHead from '@components/SectionHead.astro';

const PRESS_LOGO_COUNT = 4;

const placeholderLabels = Array.from({ length: PRESS_LOGO_COUNT }, () => '[Logo placeholder]');
---

<section
    class="section section--tint"
    aria-labelledby="press-wall-title"
>
    <div class="shell">
        <SectionHead
            eyebrow={'Press & media \u2014 2025'}
            headingId="press-wall-title"
        >
            As seen &amp; heard
        </SectionHead>
        <LogoWall placeholderLabels={placeholderLabels} />
    </div>
</section>
