---
import { Image } from 'astro:assets';

import SectionHead from '@components/SectionHead.astro';
import photoAnna from '@images/team/anna_madewell.webp';
---

<section
    class="section section--tint"
    aria-labelledby="team-founder-title"
>
    <div class="shell">
        <div class="team-founder grid items-center">
            <div
                class="aspect-[4/5] overflow-clip rounded-card -rotate-2 shadow-pop-purple"
                data-scroll="left"
            >
                <Image
                    class="object-cover h-full w-full"
                    alt="Anna Madewell holding a vintage microphone"
                    loading="lazy"
                    sizes="(max-width: 48rem) 100vw, 24rem"
                    src={photoAnna}
                    widths={[600, 1_200]}
                />
            </div>
            <div
                class="team-founder__content"
                data-scroll="right"
                data-scroll-stagger
            >
                <SectionHead
                    eyebrow="Founder spotlight"
                    headingId="team-founder-title"
                >
                    Anna Madewell
                    <p
                        class="team-founder__role"
                        slot="text"
                    >
                        Founder &amp; Festival Director &middot; Madewell Productions
                    </p>
                </SectionHead>
                <p data-scroll>The director behind EmpowHER Festival, Anna leads Madewell Productions in cross-collaboration with Austin's creative collectives &mdash; turning one venue, three stages, and a 20-person team into a storytelling immersive music production.</p>
                <p
                    class="team-founder__impact"
                    data-scroll
                >
                    Under her direction, EmpowHER 2025 generated $10,000+ in cash sponsorships and ticket revenue while building a growing movement around authenticity and self-expression.
                </p>
                <div
                    class="flex flex-wrap gap-4"
                    data-scroll
                >
                    <a
                        class="button button--primary"
                        href="/contact"
                    >
                        Work with us
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .team-founder {
        gap: clamp(2rem, calc(1.33rem + 3.33vw), 4rem);
        grid-template-columns: minmax(15rem, 24rem) minmax(0, 1fr);
    }

    .team-founder .team-founder__role {
        color: var(--color-pink);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .team-founder__content {
        overflow-clip-margin: 0.5rem;
        overflow-x: clip;
    }

    .team-founder__impact {
        margin-bottom: 1.5rem;
    }

    @media (max-width: 48rem) {
        .team-founder {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
