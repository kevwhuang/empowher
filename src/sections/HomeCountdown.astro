---
import SectionHead from '@components/SectionHead.astro';

const EVENT_DATETIME = '2027-04-17T12:00:00-05:00';

const UNITS = [
    { label: 'Days', unit: 'days' },
    { label: 'Hours', unit: 'hours' },
    { label: 'Minutes', unit: 'minutes' },
    { label: 'Seconds', unit: 'seconds' },
] as const;
---

<section
    class="section text-center"
    aria-labelledby="home-countdown-title"
>
    <div
        class="shell"
        data-scroll
        data-scroll-stagger
    >
        <SectionHead
            eyebrow="The clock is ticking"
            headingId="home-countdown-title"
            isCentered
        >
            EmpowHER goes live in
        </SectionHead>
        <dl
            class="home-countdown flex flex-wrap justify-center select-none"
            aria-label="Event countdown"
            data-countdown={EVENT_DATETIME}
            data-scroll="scale"
        >
            {UNITS.map(({ label, unit }) => (
                <div class="flex flex-col-reverse items-center gap-2">
                    <dt class="font-mono text-[0.875rem] tracking-[0.2em] uppercase text-lavender">{label}</dt>
                    <dd
                        class="home-countdown__number"
                        data-unit={unit}
                    >
                        00
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .home-countdown {
        gap: clamp(0.75rem, calc(0.5rem + 1.25vw), 1.5rem);
    }

    .home-countdown__number {
        background: var(--color-ink-light);
        border: var(--border-soft);
        border-radius: var(--radius-card-sm);
        box-shadow: var(--shadow-pop-purple);
        font-family: var(--font-display);
        font-size: clamp(2.25rem, calc(1.5rem + 3.75vw), 4.5rem);
        font-variant-numeric: tabular-nums;
        font-weight: 900;
        line-height: 1;
        padding: 0.45em 0.6em;
    }

    .home-countdown__number--tick {
        animation: home-countdown__tick var(--duration-base) var(--ease-pop) both;
    }

    @keyframes home-countdown__tick {
        0% {
            opacity: 0.2;
            transform: translateY(-0.35em);
        }

        100% {
            opacity: 1;
            transform: none;
        }
    }
</style>

<script>
    import { REDUCED_MOTION_QUERY } from '@lib/constants';

    const MS_PER_SECOND = 1_000;
    const PAD_LENGTH = 2;
    const SECONDS_PER_DAY = 86_400;
    const SECONDS_PER_HOUR = 3_600;
    const SECONDS_PER_MINUTE = 60;

    const reducedMotionQuery = window.matchMedia(REDUCED_MOTION_QUERY);

    let countdownInterval: ReturnType<typeof setInterval> | undefined;
    let daysElement: HTMLElement | null = null;
    let hoursElement: HTMLElement | null = null;
    let minutesElement: HTMLElement | null = null;
    let secondsElement: HTMLElement | null = null;
    let targetTime = 0;

    function initCountdown() {
        clearInterval(countdownInterval);

        const root = document.querySelector<HTMLElement>('[data-countdown]');

        if (!root) return;

        targetTime = new Date(root.dataset.countdown ?? '').getTime();

        if (Number.isNaN(targetTime)) return;

        daysElement = root.querySelector<HTMLElement>('[data-unit="days"]');
        hoursElement = root.querySelector<HTMLElement>('[data-unit="hours"]');
        minutesElement = root.querySelector<HTMLElement>('[data-unit="minutes"]');
        secondsElement = root.querySelector<HTMLElement>('[data-unit="seconds"]');
        update();
        countdownInterval = setInterval(update, MS_PER_SECOND);
    }

    function setValue(element: HTMLElement | null, value: number) {
        const text = String(value).padStart(PAD_LENGTH, '0');

        if (!element || element.textContent === text) return;

        element.textContent = text;

        if (element.dataset.unit === 'seconds' || reducedMotionQuery.matches) return;

        element.classList.remove('home-countdown__number--tick');
        void element.offsetWidth;
        element.classList.add('home-countdown__number--tick');
    }

    function update() {
        const remaining = Math.max(0, targetTime - Date.now());

        const totalSeconds = Math.floor(remaining / MS_PER_SECOND);

        setValue(daysElement, Math.floor(totalSeconds / SECONDS_PER_DAY));
        setValue(hoursElement, Math.floor((totalSeconds % SECONDS_PER_DAY) / SECONDS_PER_HOUR));
        setValue(minutesElement, Math.floor((totalSeconds % SECONDS_PER_HOUR) / SECONDS_PER_MINUTE));
        setValue(secondsElement, totalSeconds % SECONDS_PER_MINUTE);
    }

    document.addEventListener('astro:page-load', initCountdown);
</script>
