---

---

<section
    class="error-server"
    aria-labelledby="error-server-title"
>
    <div class="container">
        <p
            class="error-server__code"
            aria-hidden="true"
        >
            <span>5</span>
            <span>0</span>
            <span>0</span>
        </p>
        <h1 id="error-server-title">Something skipped a beat</h1>
        <p class="error-server__lede">Our end hit a snag &mdash; give it a moment and try again. The festival isn't going anywhere.</p>
        <div class="flex flex-wrap justify-center gap-4">
            <a
                class="btn btn--large btn--primary"
                href="/"
            >
                Take me home
            </a>
            <a
                class="btn btn--ghost btn--large"
                href="/contact"
            >
                Report the problem
            </a>
        </div>
    </div>
</section>

<style>
    .error-server {
        display: grid;
        min-height: calc(100svh - var(--spacing-header));
        padding: clamp(3rem, 7vw, 5rem) 0;
        place-items: center;
        text-align: center;
    }

    .error-server p {
        color: var(--color-lavender);
        margin-inline: auto;
        max-width: 40ch;
    }

    .error-server__code {
        display: flex;
        font-family: var(--font-display);
        font-size: clamp(5rem, 18vw, 11rem);
        font-weight: 900;
        justify-content: center;
        letter-spacing: 0.02em;
        line-height: 1;
    }

    .error-server__code span:nth-child(1) {
        color: var(--color-purple);
        rotate: -7deg;
    }

    .error-server__code span:nth-child(2) {
        color: var(--color-pink);
        rotate: 4deg;
        translate: 0 -0.06em;
    }

    .error-server__code span:nth-child(3) {
        color: var(--color-cyan);
        rotate: -3deg;
    }

    .error-server__lede {
        margin-bottom: 2rem;
    }
</style>
