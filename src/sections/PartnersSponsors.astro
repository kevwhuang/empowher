---
import LogoWall from '@components/LogoWall.astro';
import SectionHead from '@components/SectionHead.astro';
import logoBeatbox from '@images/logos/beatbox.webp';
import logoHitzero from '@images/logos/hitzero.webp';
import logoLightstrike from '@images/logos/lightstrike.webp';
import logoOffday from '@images/logos/offday_ice_cream_club.webp';
import logoTequila512 from '@images/logos/tequila_512.webp';
import logoTravelLeisure from '@images/logos/travel_leisure.webp';

const SPONSORS = [
    { alt: 'BeatBox Beverages', image: logoBeatbox },
    { alt: 'HitZero', image: logoHitzero },
    { alt: 'Lightstrike Hard Refresher', image: logoLightstrike },
    { alt: 'Offday Ice Cream Club', image: logoOffday },
    { alt: 'Tequila 512', image: logoTequila512 },
    { alt: 'Travel + Leisure', image: logoTravelLeisure },
];
---

<section
    class="section"
    aria-labelledby="partners-sponsors-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="2025 sponsors"
            headingId="partners-sponsors-title"
        >
            The brands that backed 2025
            <p slot="text">Cash sponsors and partners who put their name behind EmpowHER 2025.</p>
        </SectionHead>
        <LogoWall
            isWide
            logos={SPONSORS}
        />
    </div>
</section>
