---
import { EMAIL_MAX, LINKS, MESSAGE_MAX, NAME_MAX, TOPICS } from '@lib/constants';

const CARDS = [
    { href: `mailto:${LINKS.email}`, icon: '\u2709', title: 'Email', value: LINKS.email },
    { href: LINKS.instagram, icon: '\u2726', isExternal: true, title: 'Instagram', value: LINKS.instagramHandle },
];
---

<section
    class="contact-panel section overflow-x-clip"
    aria-labelledby="contact-panel-title"
>
    <div class="shell">
        <h2
            id="contact-panel-title"
            class="sr-only"
        >
            Ways to reach us
        </h2>
        <div class="contact-panel__grid grid items-start">
            <ul
                class="grid gap-5 list-none"
                data-scroll="left"
                data-scroll-stagger
            >
                {CARDS.map(card => (
                    <li data-scroll>
                        <a
                            class="card contact-panel__card flex items-center gap-4"
                            href={card.href}
                            rel={card.isExternal ? 'noopener noreferrer' : undefined}
                            target={card.isExternal ? '_blank' : undefined}
                        >
                            <span
                                class="grid place-items-center shrink-0 size-12 rounded-full text-[1.25rem] bg-purple-15 text-purple"
                                aria-hidden="true"
                            >
                                {card.icon}
                            </span>
                            <dl class="contact-panel__card-body">
                                <dt>{card.title}</dt>
                                <dd>{card.value}</dd>
                            </dl>
                        </a>
                    </li>
                ))}
            </ul>
            <div
                class="card"
                data-scroll="right"
            >
                <h2>Send a message</h2>
                <form
                    class="contact-panel__form grid gap-4"
                    novalidate
                >
                    <div class="contact-panel__form-row grid grid-cols-2 gap-4">
                        <div class="contact-panel__field grid gap-2">
                            <label class="grid gap-2">
                                <span>
                                    Name&nbsp;
                                    <span
                                        class="text-pink"
                                        aria-hidden="true"
                                    >
                                        *
                                    </span>
                                </span>
                                <input
                                    autocomplete="name"
                                    data-error="contact-panel-error-name"
                                    maxlength={NAME_MAX}
                                    name="name"
                                    required
                                    type="text"
                                />
                            </label>
                            <p
                                id="contact-panel-error-name"
                                class="contact-panel__error"
                                hidden
                            >
                                Please enter your name.
                            </p>
                        </div>
                        <div class="contact-panel__field grid gap-2">
                            <label class="grid gap-2">
                                <span>
                                    Email&nbsp;
                                    <span
                                        class="text-pink"
                                        aria-hidden="true"
                                    >
                                        *
                                    </span>
                                </span>
                                <input
                                    autocomplete="email"
                                    data-error="contact-panel-error-email"
                                    maxlength={EMAIL_MAX}
                                    name="email"
                                    required
                                    type="email"
                                />
                            </label>
                            <p
                                id="contact-panel-error-email"
                                class="contact-panel__error"
                                hidden
                            >
                                Please enter a valid email.
                            </p>
                        </div>
                    </div>
                    <div class="contact-panel__field grid gap-2">
                        <label class="grid gap-2">
                            <span>
                                I'm reaching out about&nbsp;
                                <span
                                    class="text-pink"
                                    aria-hidden="true"
                                >
                                    *
                                </span>
                            </span>
                            <span class="contact-panel__select grid relative">
                                <select
                                    data-error="contact-panel-error-topic"
                                    name="topic"
                                    required
                                >
                                    <option
                                        disabled
                                        selected
                                        value=""
                                    >
                                        Choose a topic&hellip;
                                    </option>
                                    {TOPICS.map(topic => (
                                        <option value={topic.value}>{topic.label}</option>
                                    ))}
                                </select>
                            </span>
                        </label>
                        <p
                            id="contact-panel-error-topic"
                            class="contact-panel__error"
                            hidden
                        >
                            Please choose a topic.
                        </p>
                    </div>
                    <div class="contact-panel__field grid gap-2">
                        <label class="grid gap-2">
                            <span>
                                Message&nbsp;
                                <span
                                    class="text-pink"
                                    aria-hidden="true"
                                >
                                    *
                                </span>
                            </span>
                            <textarea
                                class="min-h-32 resize-y"
                                data-error="contact-panel-error-message"
                                maxlength={MESSAGE_MAX}
                                name="message"
                                required
                            />
                        </label>
                        <p
                            id="contact-panel-error-message"
                            class="contact-panel__error"
                            hidden
                        >
                            Please add a short message.
                        </p>
                    </div>
                    <button
                        class="button button--large button--primary"
                        type="submit"
                    >
                        Send it
                    </button>
                    <p class="contact-panel__network-error" hidden role="alert" />
                </form>
                <p
                    class="contact-panel__success px-5 py-4 border-[0.0625rem] border-cyan-40 rounded-card-sm font-semibold bg-cyan-15"
                    hidden
                    role="status"
                    tabindex="-1"
                >
                    Got it! We'll get back to you soon. <span aria-hidden="true">&#x1f49c;</span>
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-panel__card {
        text-decoration: none;
    }

    .contact-panel__card:active {
        border-color: var(--color-purple-bright);
        transform: none;
    }

    .contact-panel__card-body dd {
        color: var(--color-paper);
        font-weight: 600;
    }

    .contact-panel__card-body dt {
        color: var(--color-lavender);
        font-family: var(--font-display);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1.12;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
    }

    .contact-panel__error,
    .contact-panel__network-error {
        color: var(--color-pink);
        font-size: 0.75rem;
        margin-bottom: 0;
    }

    .contact-panel__field > label > span:not(.contact-panel__select) {
        color: var(--color-lavender);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    .contact-panel__field input,
    .contact-panel__field select,
    .contact-panel__field textarea {
        background: var(--color-ink-light);
        border: 0.0625rem solid var(--color-paper-35);
        border-radius: var(--radius-card-sm);
        color: var(--color-paper);
        font-size: 1rem;
        padding: 0.75rem 1rem;
        transition:
            border-color var(--duration-fast) ease,
            box-shadow var(--duration-fast) ease;
        width: 100%;
    }

    .contact-panel__field input:active,
    .contact-panel__field select:active,
    .contact-panel__field textarea:active {
        border-color: var(--color-purple-bright);
    }

    .contact-panel__field input:focus-visible,
    .contact-panel__field select:focus-visible,
    .contact-panel__field textarea:focus-visible {
        border-color: var(--color-purple);
        box-shadow: 0 0 0 0.1875rem var(--color-purple-25);
    }

    .contact-panel__field input:hover,
    .contact-panel__field select:hover,
    .contact-panel__field textarea:hover {
        border-color: var(--color-paper-40);
    }

    .contact-panel__field select {
        appearance: none;
        padding-right: 2.75rem;
    }

    .contact-panel__form button::after {
        content: '\2726';
        content: '\2726' / '';
    }

    .contact-panel__grid {
        gap: clamp(2rem, calc(1.33rem + 3.33vw), 4rem);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    }

    .contact-panel__select::after {
        color: var(--color-lavender);
        content: '\25BE';
        content: '\25BE' / '';
        font-size: 1.25rem;
        pointer-events: none;
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
    }

    .contact-panel__success {
        color: var(--color-cyan);
    }

    @media (max-width: 48rem) {
        .contact-panel__form-row {
            grid-template-columns: minmax(0, 1fr);
        }

        .contact-panel__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { ERROR_GENERIC, ERROR_RATE_LIMITED, JSON_HEADERS, STATUS_RATE_LIMITED } from '@lib/constants';
    import { registerPageScript, showMessage } from '@lib/utils';

    type FormControl = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    function handleInput(event: Event) {
        const control = event.target;

        if (!(control instanceof HTMLElement)) return;

        const error = document.getElementById(control.dataset.error ?? '');

        if (!error) return;

        control.removeAttribute('aria-describedby');
        error.hidden = true;
    }

    async function handleSubmit(event: SubmitEvent) {
        event.preventDefault();

        const form = event.currentTarget;

        if (!(form instanceof HTMLFormElement)) return;

        const controls = form.querySelectorAll<FormControl>('[data-error]');
        const networkError = form.querySelector<HTMLElement>('.contact-panel__network-error');
        const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        controls.forEach(syncControlError);

        if (!form.checkValidity()) {
            form.querySelector<HTMLElement>(':invalid')?.focus();

            return;
        }

        if (networkError) networkError.hidden = true;
        if (submitButton) submitButton.disabled = true;

        try {
            const data = new FormData(form);

            const response = await fetch('/api/contact', {
                body: JSON.stringify({
                    email: data.get('email'),
                    message: data.get('message'),
                    name: data.get('name'),
                    topic: data.get('topic'),
                }),
                headers: JSON_HEADERS,
                method: 'POST',
            });

            if (!response.ok) {
                showMessage(networkError, response.status === STATUS_RATE_LIMITED ? ERROR_RATE_LIMITED : ERROR_GENERIC);

                return;
            }

            const successMessage = document.querySelector<HTMLElement>('.contact-panel__success');

            if (successMessage) {
                successMessage.hidden = false;
                successMessage.focus();
            }

            form.hidden = true;
        } catch {
            showMessage(networkError, ERROR_GENERIC);
        } finally {
            if (submitButton) submitButton.disabled = false;
        }
    }

    function initContactPanel(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.contact-panel__form');

        form?.addEventListener('input', handleInput, { signal });
        form?.addEventListener('submit', handleSubmit, { signal });
    }

    function syncControlError(control: FormControl) {
        const error = document.getElementById(control.dataset.error ?? '');

        if (!error) return;

        if (!(control instanceof HTMLSelectElement)) control.value = control.value.trim();

        const isValid = control.checkValidity();

        error.hidden = isValid;

        if (isValid) control.removeAttribute('aria-describedby');
        else control.setAttribute('aria-describedby', error.id);
    }

    registerPageScript(initContactPanel);
</script>
